{
  "name": "@quantixlab/maps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "cli": "tsx src/cli/index.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi:generate": "tsx src/contracts/generate-openapi.ts",
    "openapi:check": "npm run openapi:generate && git diff --exit-code -- openapi/quantixlab-maps.v1.json",
    "sdk:generate": "openapi-typescript openapi/quantixlab-maps.v1.json -o packages/typescript-client/src/schema.d.ts",
    "sdk:check": "npm run sdk:generate && git diff --exit-code -- packages/typescript-client/src/schema.d.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run openapi:check && npm run sdk:check"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.1.0",
    "commander": "^14.0.0",
    "express": "^5.1.0",
    "prom-client": "^15.1.3",
    "redis": "^5.8.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.1",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^9.35.0",
    "openapi-typescript": "^7.9.1",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^5.0.0"
  },
  "overrides": { "js-yaml": "4.3.2" }
}
