{
  "version": 8,
  "name": "Quantix Lab Light",
  "metadata": { "quantixlab:dataset": "__DATASET_VERSION__" },
  "glyphs": "__MAP_PUBLIC_BASE_URL__/v1/fonts/{fontstack}/{range}.pbf",
  "sources": { "region": { "type": "vector", "url": "__MAP_PUBLIC_BASE_URL__/v1/tiles/region.json", "attribution": "© OpenStreetMap contributors" } },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f4f7f5" } },
    { "id": "landcover", "type": "fill", "source": "region", "source-layer": "landcover", "paint": { "fill-color": ["match", ["get", "class"], "wood", "#d7e7d4", "grass", "#e2ecd9", "#e7ede5"], "fill-opacity": 0.72 } },
    { "id": "landuse", "type": "fill", "source": "region", "source-layer": "landuse", "paint": { "fill-color": ["match", ["get", "class"], "residential", "#ecefec", "industrial", "#e7e4e2", "cemetery", "#dce9db", "#e7ede5"], "fill-opacity": 0.8 } },
    { "id": "park", "type": "fill", "source": "region", "source-layer": "park", "paint": { "fill-color": "#d9e8d2" } },
    { "id": "water", "type": "fill", "source": "region", "source-layer": "water", "paint": { "fill-color": "#b9dce7" } },
    { "id": "waterway", "type": "line", "source": "region", "source-layer": "waterway", "minzoom": 9, "paint": { "line-color": "#90c9da", "line-width": ["interpolate", ["linear"], ["zoom"], 9, 0.5, 16, 2.5] } },
    { "id": "boundaries", "type": "line", "source": "region", "source-layer": "boundary", "paint": { "line-color": "#8a9797", "line-opacity": 0.6, "line-dasharray": [3, 2] } },
    { "id": "building", "type": "fill", "source": "region", "source-layer": "building", "minzoom": 13, "paint": { "fill-color": "#d7dad8" } },
    { "id": "tunnels", "type": "line", "source": "region", "source-layer": "transportation", "filter": ["==", ["get", "brunnel"], "tunnel"], "paint": { "line-color": "#d1d6d4", "line-dasharray": [2, 2], "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 17, 6] } },
    { "id": "road-casing", "type": "line", "source": "region", "source-layer": "transportation", "filter": ["!=", ["get", "class"], "rail"], "paint": { "line-color": "#cdd3d0", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 1, 12, 3, 17, 11] } },
    { "id": "road", "type": "line", "source": "region", "source-layer": "transportation", "filter": ["!=", ["get", "class"], "rail"], "paint": { "line-color": ["match", ["get", "class"], ["motorway", "trunk"], "#f4cf89", ["primary", "secondary"], "#fff1c9", ["path", "track"], "#e5e2d7", "#ffffff"], "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.5, 12, ["match", ["get", "class"], ["motorway", "trunk"], 3.5, ["primary", "secondary"], 2.5, 1], 17, ["match", ["get", "class"], ["motorway", "trunk"], 9, ["primary", "secondary"], 7, 4]] } },
    { "id": "bridges", "type": "line", "source": "region", "source-layer": "transportation", "filter": ["==", ["get", "brunnel"], "bridge"], "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1.5, 17, 7] } },
    { "id": "railways", "type": "line", "source": "region", "source-layer": "transportation", "filter": ["==", ["get", "class"], "rail"], "paint": { "line-color": "#9ca6a6", "line-width": 1.2, "line-dasharray": [3, 2] } },
    { "id": "road-label", "type": "symbol", "source": "region", "source-layer": "transportation_name", "minzoom": 11, "layout": { "symbol-placement": "line", "text-field": ["format", ["coalesce", ["get", "name"], ["get", "name:latin"], ["get", "name:en"], ["get", "ref"], ""], {}, ["case", ["all", ["has", "name:en"], ["!=", ["get", "name:en"], ["coalesce", ["get", "name"], ["get", "name:latin"], ""]]], ["concat", "\n", ["get", "name:en"]], ""], { "font-scale": 0.8 }], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 11, 10, 17, 13], "text-max-angle": 30 }, "paint": { "text-color": "#53616a", "text-halo-color": "#ffffff", "text-halo-width": 1.5 } },
    { "id": "water-label", "type": "symbol", "source": "region", "source-layer": "water_name", "minzoom": 8, "layout": { "text-field": ["coalesce", ["get", "name"], ["get", "name:latin"], ["get", "name:en"]], "text-font": ["Noto Sans Regular"], "text-size": 11 }, "paint": { "text-color": "#438ba2", "text-halo-color": "#ffffff", "text-halo-width": 1.5 } },
    { "id": "aerodrome-label", "type": "symbol", "source": "region", "source-layer": "aerodrome_label", "minzoom": 10, "layout": { "text-field": ["coalesce", ["get", "name"], ["get", "name:latin"], ["get", "name:en"], ["get", "iata"]], "text-font": ["Noto Sans Regular"], "text-size": 11 }, "paint": { "text-color": "#59666c", "text-halo-color": "#ffffff", "text-halo-width": 1.5 } },
    { "id": "place-label", "type": "symbol", "source": "region", "source-layer": "place", "layout": { "symbol-sort-key": ["coalesce", ["get", "rank"], 20], "text-field": ["format", ["coalesce", ["get", "name"], ["get", "name:latin"], ["get", "name:en"], ""], {}, ["case", ["all", ["has", "name:en"], ["!=", ["get", "name:en"], ["coalesce", ["get", "name"], ["get", "name:latin"], ""]]], ["concat", "\n", ["get", "name:en"]], ""], { "font-scale": 0.8 }], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 12, 13, 17, 16] }, "paint": { "text-color": "#263238", "text-halo-color": "#ffffff", "text-halo-width": 2 } },
    { "id": "poi-label", "type": "symbol", "source": "region", "source-layer": "poi", "minzoom": 14, "layout": { "text-field": ["coalesce", ["get", "name"], ["get", "name:latin"], ["get", "name:en"]], "text-font": ["Noto Sans Regular"], "text-size": 11, "text-offset": [0, 0.8] }, "paint": { "text-color": "#45545a", "text-halo-color": "#ffffff", "text-halo-width": 1.5 } },
    { "id": "peak-label", "type": "symbol", "source": "region", "source-layer": "mountain_peak", "minzoom": 11, "layout": { "text-field": ["coalesce", ["get", "name"], ["get", "name:latin"], ["get", "name:en"]], "text-font": ["Noto Sans Regular"], "text-size": 10 }, "paint": { "text-color": "#5c676b", "text-halo-color": "#ffffff", "text-halo-width": 1 } },
    { "id": "building-label", "type": "symbol", "source": "region", "source-layer": "building", "minzoom": 16, "layout": { "text-field": ["coalesce", ["get", "name"], ["get", "name:latin"], ["get", "name:en"]], "text-font": ["Noto Sans Regular"], "text-size": 10 }, "paint": { "text-color": "#69777b", "text-halo-color": "#ffffff", "text-halo-width": 1 } },
    { "id": "house-number", "type": "symbol", "source": "region", "source-layer": "housenumber", "minzoom": 17, "layout": { "text-field": ["get", "housenumber"], "text-font": ["Noto Sans Regular"], "text-size": 9 }, "paint": { "text-color": "#748084", "text-halo-color": "#ffffff", "text-halo-width": 1 } }
  ]
}
